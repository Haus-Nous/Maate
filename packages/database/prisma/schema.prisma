// ============================================
// MAATE — Prisma Schema (Part 1/3)
// Generator, datasource, enums, auth models
// HIPAA-ready · FHIR-compatible · Soft deletes
// ============================================

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENUMS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  PATIENT
  CAREGIVER
  FAMILY_ADMIN
  DOCTOR
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

enum DocumentType {
  LAB_REPORT
  PRESCRIPTION
  DISCHARGE_SUMMARY
  IMAGING
  INSURANCE
  VACCINATION
  DOCTOR_NOTE
  REFERRAL
  CONSENT_FORM
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReminderFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THRICE_DAILY
  FOUR_TIMES
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum MealRelation {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  EMPTY_STOMACH
  ANY
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum ReminderType {
  MEDICINE
  WATER
  MEAL
  APPOINTMENT
  VITAL_CHECK
}

enum ReminderResponse {
  TAKEN
  SKIPPED
  SNOOZED
  MISSED
}

enum HealthStatus {
  NORMAL
  LOW
  HIGH
  CRITICAL
  BORDERLINE
}

enum FamilyRole {
  ADMIN
  CAREGIVER
  MEMBER
  DEPENDENT
}

enum NotificationType {
  REMINDER
  ALERT
  INFO
  ESCALATION
  SYSTEM
  ACHIEVEMENT
}

enum NotificationChannel {
  PUSH
  SMS
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum VitalType {
  BLOOD_PRESSURE
  HEART_RATE
  TEMPERATURE
  BLOOD_OXYGEN
  BLOOD_SUGAR
  WEIGHT
  HEIGHT
  BMI
  RESPIRATORY_RATE
  STEPS
  SLEEP_HOURS
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum ConditionStatus {
  ACTIVE
  REMISSION
  RESOLVED
  RECURRING
}

enum TimelineEventType {
  DOCUMENT_UPLOADED
  LAB_RESULT
  PRESCRIPTION_ADDED
  MEDICATION_STARTED
  MEDICATION_STOPPED
  VITAL_RECORDED
  SYMPTOM_REPORTED
  CONDITION_DIAGNOSED
  CONDITION_RESOLVED
  APPOINTMENT
  DOCTOR_VISIT
  HOSPITALIZATION
  VACCINATION
  SURGERY
  AI_INSIGHT
  MILESTONE
}

enum MedicationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DISCONTINUED
  EXPIRED
}

enum RelationshipType {
  SELF
  SPOUSE
  PARENT
  CHILD
  SIBLING
  GRANDPARENT
  OTHER
}

enum AccessLevel {
  VIEW
  EDIT
  FULL
  EMERGENCY
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AUTH MODELS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String?   @unique @db.VarChar(15)
  email           String?   @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(100)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          Gender?
  bloodGroup      String?   @map("blood_group") @db.VarChar(5)
  avatarUrl       String?   @map("avatar_url")
  locale          String    @default("en-IN") @db.VarChar(10)
  timezone        String    @default("Asia/Kolkata") @db.VarChar(50)
  role            UserRole  @default(PATIENT)
  heightCm        Float?    @map("height_cm")
  weightKg        Float?    @map("weight_kg")
  emergencyContact String?  @map("emergency_contact") @db.VarChar(15)
  allergiesJson   Json?     @map("allergies_json")
  onboardingDone  Boolean   @default(false) @map("onboarding_done")
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  fcmToken        String?   @map("fcm_token")
  apnsToken       String?   @map("apns_token")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  loginCount      Int       @default(0) @map("login_count")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Auth relations
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  sessions           UserSession[]
  passwordResets      PasswordReset[]
  // Domain relations
  documents          Document[]         @relation("UserDocuments")
  uploadedDocuments  Document[]         @relation("UploadedByUser")
  medications        Medication[]
  prescriptions      Prescription[]     @relation("UserPrescriptions")
  prescribedBy       Prescription[]     @relation("PrescribedByDoctor")
  medicineReminders  MedicineReminder[] @relation("UserMedicineReminders")
  createdReminders   MedicineReminder[] @relation("CreatedByUser")
  waterReminder      WaterReminder?
  mealReminders      MealReminder[]
  reminderLogs       ReminderLog[]      @relation("UserReminderLogs")
  escalationLogs     ReminderLog[]      @relation("EscalatedToUser")
  healthRecords      HealthRecord[]
  vitalSigns         VitalSign[]
  symptoms           SymptomEntry[]
  chronicConditions  ChronicCondition[]
  timelineEvents     TimelineEvent[]
  doctorNotes        DoctorNote[]       @relation("PatientNotes")
  authoredNotes      DoctorNote[]       @relation("AuthoredNotes")
  familyMemberships  FamilyGroupMember[]
  createdGroups      FamilyGroup[]
  doctorShares       DoctorShare[]
  chatSessions       ChatSession[]
  notifications      Notification[]
  // Infrastructure relations
  devices            UserDevice[]
  consents           DataConsent[]
  mfa                UserMfa?
  // Family profiles
  familyMembers      FamilyMember[] @relation("UserFamilyMembers")
  permissions        AccessPermission[] @relation("UserPermissions")
  grantedPermissions AccessPermission[] @relation("PermissionsGrantedBy")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model OAuthAccount {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  provider      AuthProvider
  providerId    String       @map("provider_id") @db.VarChar(255)
  email         String?      @db.VarChar(255)
  displayName   String?      @map("display_name") @db.VarChar(100)
  avatarUrl     String?      @map("avatar_url")
  accessToken   String?      @map("access_token")
  refreshToken  String?      @map("refresh_token")
  tokenExpiry   DateTime?    @map("token_expiry") @db.Timestamptz
  rawProfile    Json?        @map("raw_profile")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @unique @db.VarChar(500)
  family      String   @default(uuid()) @db.VarChar(36)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  isRevoked   Boolean  @default(false) @map("is_revoked")
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  deviceName    String?  @map("device_name") @db.VarChar(100)
  deviceOS      String?  @map("device_os") @db.VarChar(30)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  lastActiveAt  DateTime @default(now()) @map("last_active_at") @db.Timestamptz
  isActive      Boolean  @default(true) @map("is_active")
  biometricKey  String?  @map("biometric_key") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_sessions")
}

model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CLINICAL DOMAIN — Documents, OCR, AI
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Document {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  uploadedBy        String?          @map("uploaded_by") @db.Uuid
  title             String?          @db.VarChar(255)
  documentType      DocumentType     @map("document_type")
  fileUrl           String           @map("file_url")
  fileType          String?          @map("file_type") @db.VarChar(10)
  fileSizeBytes     BigInt?          @map("file_size_bytes")
  checksum          String?          @db.VarChar(64)
  encryptionKeyId   String?          @map("encryption_key_id") @db.VarChar(64)
  ocrStatus         ProcessingStatus @default(PENDING) @map("ocr_status")
  aiSummaryStatus   ProcessingStatus @default(PENDING) @map("ai_summary_status")
  tags              String[]         @default([])
  documentDate      DateTime?        @map("document_date") @db.Date
  providerName      String?          @map("provider_name") @db.VarChar(255)
  doctorName        String?          @map("doctor_name") @db.VarChar(255)
  fhirDocRefId      String?          @map("fhir_doc_ref_id") @db.VarChar(64)
  isArchived        Boolean          @default(false) @map("is_archived")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user          User           @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploader      User?          @relation("UploadedByUser", fields: [uploadedBy], references: [id])
  ocrResult     OcrResult?
  aiSummary     AiSummary?
  healthRecords HealthRecord[]
  labReports    LabReport[]
  imagingReports ImagingReport[]
  prescriptions Prescription[]
  timelineEvents TimelineEvent[]
  chunks         DocumentChunk[]

  @@index([userId, documentDate(sort: Desc)])
  @@index([userId, documentType])
  @@index([deletedAt])
  @@index([fhirDocRefId])
  @@map("documents")
}

model OcrResult {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @unique @map("document_id") @db.Uuid
  rawText          String?
  structuredData   Json?    @map("structured_data")
  confidenceScore  Float?   @map("confidence_score")
  engineUsed       String?  @map("engine_used") @db.VarChar(30)
  engineVersion    String?  @map("engine_version") @db.VarChar(20)
  processingTimeMs Int?     @map("processing_time_ms")
  pageCount        Int?     @map("page_count")
  languageDetected String?  @map("language_detected") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ocr_results")
}

model AiSummary {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @unique @map("document_id") @db.Uuid
  summaryText      String   @map("summary_text")
  keyFindings      Json?    @map("key_findings")
  riskFlags        Json?    @map("risk_flags")
  recommendations  Json?
  laypersonSummary String?  @map("layperson_summary")
  modelUsed        String?  @map("model_used") @db.VarChar(50)
  modelVersion     String?  @map("model_version") @db.VarChar(20)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  costUsd          Float?   @map("cost_usd")
  latencyMs        Int?     @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LAB REPORTS & IMAGING
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model LabReport {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  documentId      String?      @map("document_id") @db.Uuid
  reportName      String       @map("report_name") @db.VarChar(255)
  labName         String?      @map("lab_name") @db.VarChar(255)
  orderedBy       String?      @map("ordered_by") @db.VarChar(255)
  collectionDate  DateTime?    @map("collection_date") @db.Date
  reportDate      DateTime     @map("report_date") @db.Date
  overallStatus   HealthStatus @default(NORMAL) @map("overall_status")
  fhirDiagReportId String?     @map("fhir_diag_report_id") @db.VarChar(64)
  notes           String?
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  document     Document?      @relation(fields: [documentId], references: [id])
  parameters   LabParameter[]

  @@index([userId, reportDate(sort: Desc)])
  @@index([fhirDiagReportId])
  @@map("lab_reports")
}

model LabParameter {
  id             String       @id @default(uuid()) @db.Uuid
  labReportId    String       @map("lab_report_id") @db.Uuid
  parameterName  String       @map("parameter_name") @db.VarChar(100)
  value          String       @db.VarChar(50)
  unit           String?      @db.VarChar(30)
  referenceMin   Float?       @map("reference_min")
  referenceMax   Float?       @map("reference_max")
  referenceRange String?      @map("reference_range") @db.VarChar(50)
  status         HealthStatus @default(NORMAL)
  isAbnormal     Boolean      @default(false) @map("is_abnormal")
  loincCode      String?      @map("loinc_code") @db.VarChar(20)
  snomedCode     String?      @map("snomed_code") @db.VarChar(20)
  method         String?      @db.VarChar(50)
  notes          String?

  labReport LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  @@index([labReportId])
  @@index([loincCode])
  @@map("lab_parameters")
}

model ImagingReport {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  documentId      String?   @map("document_id") @db.Uuid
  modality        String    @db.VarChar(30)
  bodyPart        String    @map("body_part") @db.VarChar(100)
  indication      String?   @db.VarChar(500)
  findings        String?
  impression      String?
  radiologistName String?   @map("radiologist_name") @db.VarChar(255)
  facilityName    String?   @map("facility_name") @db.VarChar(255)
  studyDate       DateTime  @map("study_date") @db.Date
  dicomStudyUid   String?   @map("dicom_study_uid") @db.VarChar(128)
  fhirImagStudyId String?   @map("fhir_imag_study_id") @db.VarChar(64)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  document Document? @relation(fields: [documentId], references: [id])

  @@index([userId, studyDate(sort: Desc)])
  @@index([dicomStudyUid])
  @@map("imaging_reports")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MEDICATIONS & PRESCRIPTIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Medication {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  prescriptionId  String?          @map("prescription_id") @db.Uuid
  name            String           @db.VarChar(255)
  genericName     String?          @map("generic_name") @db.VarChar(255)
  brandName       String?          @map("brand_name") @db.VarChar(255)
  dosage          String           @db.VarChar(100)
  dosageUnit      String?          @map("dosage_unit") @db.VarChar(20)
  form            String?          @db.VarChar(30)
  route           String?          @db.VarChar(30)
  frequency       ReminderFrequency
  timesOfDay      String[]         @map("times_of_day")
  mealRelation    MealRelation     @default(ANY) @map("meal_relation")
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime?        @map("end_date") @db.Date
  status          MedicationStatus @default(ACTIVE)
  instructions    String?
  sideEffects     String[]         @map("side_effects") @default([])
  rxcui           String?          @db.VarChar(20)
  ndcCode         String?          @map("ndc_code") @db.VarChar(20)
  snomedCode      String?          @map("snomed_code") @db.VarChar(20)
  refillsLeft     Int?             @map("refills_left")
  pharmacy        String?          @db.VarChar(255)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  interactions MedicationInteraction[] @relation("MedicationA")
  interactedBy MedicationInteraction[] @relation("MedicationB")

  @@index([userId, status])
  @@index([rxcui])
  @@index([deletedAt])
  @@map("medications")
}

model MedicationInteraction {
  id              String   @id @default(uuid()) @db.Uuid
  medicationAId   String   @map("medication_a_id") @db.Uuid
  medicationBId   String   @map("medication_b_id") @db.Uuid
  severity        Severity
  description     String
  recommendation  String?
  source          String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  medicationA Medication @relation("MedicationA", fields: [medicationAId], references: [id], onDelete: Cascade)
  medicationB Medication @relation("MedicationB", fields: [medicationBId], references: [id], onDelete: Cascade)

  @@unique([medicationAId, medicationBId])
  @@map("medication_interactions")
}

model Prescription {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  documentId      String?   @map("document_id") @db.Uuid
  prescribedById  String?   @map("prescribed_by_id") @db.Uuid
  doctorName      String    @map("doctor_name") @db.VarChar(255)
  doctorLicense   String?   @map("doctor_license") @db.VarChar(50)
  clinicName      String?   @map("clinic_name") @db.VarChar(255)
  diagnosis       String?   @db.VarChar(500)
  icdCodes        String[]  @map("icd_codes") @default([])
  prescriptionDate DateTime @map("prescription_date") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  followUpDate    DateTime? @map("follow_up_date") @db.Date
  notes           String?
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  fhirMedReqId    String?   @map("fhir_med_req_id") @db.VarChar(64)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation("UserPrescriptions", fields: [userId], references: [id], onDelete: Cascade)
  prescriber   User?        @relation("PrescribedByDoctor", fields: [prescribedById], references: [id])
  document     Document?    @relation(fields: [documentId], references: [id])
  medications  Medication[]

  @@index([userId, prescriptionDate(sort: Desc)])
