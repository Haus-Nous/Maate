# ==============================================================================
# MAATE — Staging Environment Configuration Template (.env.staging)
# Copy this file to .env.staging on your VPS:
#   cp .env.staging.example .env.staging
#
# IMPORTANT: All secrets below MUST be securely generated before first boot.
# ==============================================================================

# ─── 1. General & Domain Settings ─────────────────────────────────────────────
NODE_ENV=staging
STAGING_API_DOMAIN=api.staging.yourdomain.com
TLS_EMAIL=your-email@example.com

# ─── 2. CORS Allowed Origins ──────────────────────────────────────────────────
# Must strictly match your Vercel staging frontend URL (no wildcards).
# Example: https://maate-staging.vercel.app,https://staging.yourdomain.com
CORS_ORIGINS=https://your-staging-web.vercel.app

# ─── 3. PostgreSQL Database (pgvector) ────────────────────────────────────────
# PostgreSQL user, database name, and strong random password.
POSTGRES_USER=maate_staging_admin
POSTGRES_DB=maate_staging
# GENERATE: openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── 4. Redis Cache & Queue Store ─────────────────────────────────────────────
# GENERATE: openssl rand -base64 24
REDIS_PASSWORD=

# ─── 5. Application Cryptographic Keys (Mandatory >= 32 bytes) ────────────────
# JWT Access Token Secret (minimum 256 bits).
# GENERATE: openssl rand -base64 32
JWT_SECRET=

# JWT Refresh Token Secret (minimum 256 bits).
# GENERATE: openssl rand -base64 32
JWT_REFRESH_SECRET=

# MFA Secret AES-256-GCM Encryption Key (minimum 256 bits).
# GENERATE: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# ─── 6. Cloudflare R2 Object Storage (S3 API) ─────────────────────────────────
# Retrieve these credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# R2 Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maate-staging-documents

# ─── 7. External AI Provider (Groq) ───────────────────────────────────────────
# Developer API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── 8. SMTP Email Provider (Optional for staging test users) ─────────────────
# Resend / SendGrid / Brevo / Mailgun SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Maate Staging <noreply@staging.yourdomain.com>

# ─── 9. Error Monitoring & Telemetry (Optional) ───────────────────────────────
# Project DSN from https://sentry.io
SENTRY_DSN=
