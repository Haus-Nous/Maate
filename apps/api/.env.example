# ============================================
# MAATE API — Environment Configuration (.env.example)
# ============================================

# ─── Application ─────────────────────────────
# Environment mode (development | staging | production)
NODE_ENV=development
# Port on which the NestJS API server listens
APP_PORT=3000
# Logging level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info
# Pretty-print pino logs in development (true | false)
USE_PINO_PRETTY=true
# Allowed CORS origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ─── Database ────────────────────────────────
# PostgreSQL connection string for Prisma ORM
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maate_dev

# ─── Authentication & Security ───────────────
# Secret key used for signing and verifying JWT tokens
JWT_SECRET=change-this-to-a-secure-random-secret
# JWT access token expiration duration (e.g. 15m)
JWT_ACCESS_EXPIRY=15m
# JWT access token lifetime in seconds (default: 900)
JWT_ACCESS_EXPIRY_SECONDS=900
# Refresh token lifetime in days (default: 30)
JWT_REFRESH_DAYS=30
# Google OAuth client ID for social authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Maximum failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5
# Lockout duration in minutes after exceeding max failed attempts
LOCKOUT_MINUTES=15

# ─── Redis & BullMQ ──────────────────────────
# Redis server hostname
REDIS_HOST=localhost
# Redis server port
REDIS_PORT=6379
# Redis authentication password (leave empty if none)
REDIS_PASSWORD=
# Redis database index (default: 0)
REDIS_DB=0

# ─── Object Storage (S3 / MinIO) ─────────────
# S3 / MinIO endpoint URL
S3_ENDPOINT=http://localhost:9000
# S3 storage region
S3_REGION=ap-south-1
# Bucket name for storing medical documents and files
S3_BUCKET=maate-documents
# S3 Access Key ID
S3_ACCESS_KEY_ID=minioadmin
# S3 Secret Access Key
S3_SECRET_ACCESS_KEY=minioadmin123
# Force path-style URLs for MinIO / S3 compatibility (true | false)
S3_FORCE_PATH_STYLE=true
# Optional KMS key ID for SSE-KMS encryption
S3_KMS_KEY_ID=
# Presigned upload URL expiration in seconds (default: 900)
UPLOAD_URL_EXPIRY=900
# Presigned download URL expiration in seconds (default: 3600)
DOWNLOAD_URL_EXPIRY=3600
# Maximum file size allowed for upload in bytes (default: 10485760 = 10MB)
MAX_FILE_SIZE_BYTES=10485760

# ─── Downstream Services ─────────────────────
# URL of the AI summarization & chatbot service
AI_SERVICE_URL=http://localhost:8000
# URL of the OCR & NER document processing service
OCR_SERVICE_URL=http://localhost:8001

# ─── Email / SMTP ────────────────────────────
# SMTP host for notification and verification emails
SMTP_HOST=smtp.gmail.com
# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587
# Enable secure SSL/TLS connection (true | false)
SMTP_SECURE=false
# SMTP authentication username
SMTP_USER=
# SMTP authentication password
SMTP_PASS=
# From address displayed in outgoing emails
SMTP_FROM="Maate Health <noreply@maate.health>"
