# ============================================
# MAATE OCR Service — Environment Configuration (.env.example)
# ============================================

# ─── Application ─────────────────────────────
# Environment mode (development | staging | production)
ENVIRONMENT=development
# Logging level (debug | info | warning | error)
LOG_LEVEL=info

# ─── Cache & Message Queue ───────────────────
# Redis connection URL for OCR job queue
REDIS_URL=redis://localhost:6379/1

# ─── Object Storage (S3 / MinIO) ─────────────
# S3 / MinIO endpoint URL for fetching raw uploaded documents
S3_ENDPOINT=http://localhost:9000
# S3 / MinIO access key ID
S3_ACCESS_KEY=minioadmin
# S3 / MinIO secret access key
S3_SECRET_KEY=minioadmin123
# S3 bucket where source documents are uploaded
S3_BUCKET=maate-documents

# ─── OCR Engines ─────────────────────────────
# Google Cloud Vision API Key (Optional / fallback OCR engine)
GOOGLE_VISION_API_KEY=
# Tesseract OCR language codes (e.g. eng, hin+eng)
TESSERACT_LANG=eng
