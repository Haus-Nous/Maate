# ============================================
# MAATE AI Service — Environment Configuration (.env.example)
# ============================================

# ─── Application ─────────────────────────────
# Environment mode (development | staging | production)
ENVIRONMENT=development
# Logging level (debug | info | warning | error)
LOG_LEVEL=info

# ─── Cache & Database ────────────────────────
# Redis connection URL for caching and state management
REDIS_URL=redis://localhost:6379/2
# PostgreSQL connection string for health data retrieval
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maate_dev

# ─── OpenAI LLM ──────────────────────────────
# OpenAI API key for medical document summarization and chat
OPENAI_API_KEY=your-openai-api-key-here
# OpenAI model to use for inferences
OPENAI_MODEL=gpt-4o
# LLM temperature for deterministic medical outputs (0.0 - 1.0)
OPENAI_TEMPERATURE=0.1

# ─── Pinecone Vector Database ────────────────
# Pinecone API key for RAG vector search
PINECONE_API_KEY=your-pinecone-api-key-here
# Target Pinecone index name for medical embeddings
PINECONE_INDEX=maate-health
