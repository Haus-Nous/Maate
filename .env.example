# ============================================
# MAATE — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ─── Application ─────────────────────────────
NODE_ENV=development
APP_NAME=maate
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ─── Database (PostgreSQL via Supabase) ──────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maate_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Supabase ────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT / Auth ──────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── OTP / SMS (Twilio) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Object Storage (S3-compatible) ─────────
S3_BUCKET=maate-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000

# ─── AI Service ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
AI_SERVICE_URL=http://localhost:8001

# ─── OCR Service ─────────────────────────────
OCR_SERVICE_URL=http://localhost:8002
GOOGLE_VISION_API_KEY=
TESSERACT_LANG=eng

# ─── Push Notifications ─────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── Observability ───────────────────────────
SENTRY_DSN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ─── Rate Limiting ───────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:3001

# ─── SMTP / Email ────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Maate Health <noreply@maate.health>"

